# Copy to backend/.env and fill in your values (backend/.env is gitignored).

OPENAI_API_KEY=sk-...

# Agent meeting LLM (direct OpenAI chat completions, no LangChain)
AGENT_LLM_MODEL=gpt-5-nano
# Cap routing/polish reply length (default 200)
AGENT_LLM_MAX_TOKENS=200

# OpenAI TTS
TTS_MODEL=tts-1
# Fallback when token has no ttsVoiceGender
TTS_VOICE=alloy
TTS_VOICE_MALE=onyx
TTS_VOICE_FEMALE=nova

# Wake phrase defaults (comma-separated); overridden per token via agentTriggerPhrases
AGENT_TRIGGER_PHRASES=echo
# Max Levenshtein distance for fuzzy wake-word match on STT words (e.g. Eko → Echo)
AGENT_TRIGGER_MAX_EDIT_DISTANCE=2

# Max characters of transcript sent to the agent LLM (full budget)
AGENT_TRANSCRIPT_MAX_CHARS=12000
# Smaller budget for routing LLM calls (default 2500)
AGENT_ROUTING_TRANSCRIPT_MAX_CHARS=2500
# Transcript budget when calibration LLM polish is enabled (default 2000)
AGENT_CALIBRATION_TRANSCRIPT_MAX_CHARS=2000
# Set true to run an extra LLM pass to polish calibration replies (adds latency)
AGENT_CALIBRATION_LLM_POLISH=false
# Map paraphrases to calibration topics via LLM when keyword match fails (default true)
AGENT_CALIBRATION_SEMANTIC_INFERENCE=true

# Optional overrides
# AGENT_BOT_BASE_URL=http://127.0.0.1:3001
# BACKEND_DATA_DIR=backend/data
# ALLOW_TOKEN_AUTO_CREATE=true
