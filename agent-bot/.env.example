# Copy to agent-bot/.env and adjust for your machine.

AGENT_BOT_BACKEND_URL=http://127.0.0.1:8000
AGENT_BOT_PORT=3001
AGENT_DISPLAY_NAME=Echo

# Waiting loop while Echo thinks / asks the proxy (MP3 in agent-bot/assets/)
AGENT_BOT_WAITING_AUDIO_GAIN=0.25
# AGENT_BOT_WAITING_AUDIO=D:\Projects\Agentic-Meeting\agent-bot\assets\waiting-sound.mp3

# Required to decode MP3 waiting audio (if ffmpeg is not on PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Jitsi (defaults shown)
# JITSI_DOMAIN=meet.uib-study.com
# AGENT_BOT_FAKE_JITSI=false
