# Copy to f5-tts-service/.env and adjust paths for your machine.

# Required on some Windows setups: hf_xet can crash during model download (illegal instruction).
HF_HUB_DISABLE_XET=1

# Semicolon-separated on Windows if you need multiple roots
F5_TTS_ALLOWED_AUDIO_ROOTS=D:\Projects\Agentic-Meeting\backend\data\voice_samples

# Optional overrides
F5_TTS_HOST=127.0.0.1
F5_TTS_PORT=8765
# F5_TTS_MODEL=F5TTS_v1_Base
# F5_TTS_DEVICE=cuda
# Inference knobs (defaults preserve stock F5 quality; lower nfe_step for speed)
# F5_TTS_NFE_STEP=32
# F5_TTS_SPEED=1.0
