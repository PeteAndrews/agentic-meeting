# Frontend env template — copy to .env.development for local Vite, or .env.production for builds.

# Leave empty in local dev so Vite proxies /api → backend (see VITE_DEV_BACKEND_TARGET).
VITE_API_BASE_URL=

# Where Vite proxies /api during npm run dev
VITE_DEV_BACKEND_TARGET=http://127.0.0.1:8000

# Jitsi domain (no https://)
VITE_JITSI_DOMAIN=meet.uib-study.com
